# Clave de API de Google Gemini (gratis desde https://aistudio.google.com -> "Get API key").
GEMINI_API_KEY=

# Modelo de Gemini que decide las acciones.
# Si al lanzar el agente da un error de "model not found", cambia este valor por
# el que te aparezca disponible en AI Studio (por ejemplo: gemini-3.5-flash).
MNEMESIS_MODEL=gemini-2.5-flash

# URL del servidor de control del teléfono, accesible mediante:
#   adb forward tcp:8734 tcp:8734
MNEMESIS_DEVICE_URL=http://127.0.0.1:8734

# Límite de pasos percibir-decidir-actuar por tarea (salvaguarda anti-bucle).
MNEMESIS_MAX_STEPS=25
