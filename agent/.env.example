# Anthropic API key used to power the agent's decision loop.
ANTHROPIC_API_KEY=

# Claude model used to decide actions from the UI tree.
MNEMESIS_MODEL=claude-sonnet-5

# Base URL of the phone's control server, reached via:
#   adb forward tcp:8734 tcp:8734
MNEMESIS_DEVICE_URL=http://127.0.0.1:8734

# Safety cap on how many perceive-decide-act steps a single task may take.
MNEMESIS_MAX_STEPS=25
